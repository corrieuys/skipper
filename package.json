{
  "name": "skipper",
  "version": "0.1.0",
  "description": "Multi-agent orchestrator (Bun + SQLite + HTMX).",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "skipper": "./bin/skipper.js"
  },
  "files": [
    "src/",
    "prompts/",
    "config/",
    "bin/",
    "index.ts",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run index.ts",
    "dashboard": "bun run bin/cli.ts dashboard",
    "gen:assets": "bun run scripts/gen-assets.ts",
    "gen:icons": "bun run scripts/gen-lucide-icons.ts && bun run scripts/gen-assets.ts",
    "build": "bun run scripts/build-binary.ts",
    "release": "bun run scripts/release.ts",
    "test": "bun run scripts/test-with-cleanup.ts src",
    "test:full": "bun run scripts/test-with-cleanup.ts",
    "test:harness": "bun run scripts/test-with-cleanup.ts src/orchestrator/ src/agents/manager-daemon.test.ts src/tasks/scheduler.test.ts",
    "typecheck:cleanup": "bunx tsc --project tsconfig.cleanup.json --noEmit --noUnusedLocals --noUnusedParameters --pretty false"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lucide-static": "^1.43.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.45",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ai": "^7.0.95",
    "gray-matter": "4.0.3",
    "smol-toml": "1.6.1",
    "zod": "^4.5.4"
  },
  "overrides": {
    "qs": "6.16.0",
    "@hono/node-server": "2.0.10",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.7",
    "hono": "4.13.5",
    "js-yaml": "3.15.2",
    "ip-address": "10.3.1"
  }
}