{
  "agent_types": [
    {
      "name": "claude-code",
      "command": "claude",
      "args": [
        "--print",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "resume_args": null,
      "model_flag": "--model",
      "available_models": [],
      "env_vars": {},
      "supports_stdin": false,
      "supports_resume": true,
      "resume_flag": "--resume"
    },
    {
      "name": "codex",
      "command": "codex",
      "args": [
        "exec",
        "--json",
        "--dangerously-bypass-approvals-and-sandbox",
        "--skip-git-repo-check",
        "-"
      ],
      "resume_args": [
        "exec",
        "resume",
        "{{session_id}}",
        "--json",
        "--dangerously-bypass-approvals-and-sandbox",
        "--skip-git-repo-check",
        "-"
      ],
      "model_flag": "-m",
      "available_models": [],
      "env_vars": {},
      "supports_stdin": false,
      "supports_resume": true,
      "resume_flag": null
    },
    {
      "name": "opencode",
      "command": "opencode",
      "args": [
        "run",
        "{{prompt}}",
        "--format",
        "json"
      ],
      "resume_args": [
        "run",
        "{{prompt}}",
        "--format",
        "json",
        "--session",
        "{{session_id}}"
      ],
      "model_flag": "-m",
      "available_models": [],
      "env_vars": {},
      "supports_stdin": false,
      "supports_resume": true,
      "resume_flag": null
    },
    {
      "name": "grok",
      "command": "grok",
      "args": [
        "-p",
        "{{prompt}}",
        "--output-format",
        "streaming-messages-json",
        "--always-approve",
        "--no-auto-update"
      ],
      "resume_args": null,
      "model_flag": "-m",
      "available_models": [],
      "env_vars": {},
      "supports_stdin": false,
      "supports_resume": true,
      "resume_flag": "--resume"
    }
  ]
}
